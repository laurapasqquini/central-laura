{
  "manifest_version": 3,
  "name": "Central da Lau",
  "version": "1.43",
  "description": "Botão ➕ Central no WhatsApp Web e números do Beach Tênis do RANKEN Hub direto na Central da Lau.",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://qkjqngddavxoqhnhbame.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Central da Lau"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://ranken-financeiro.vercel.app/*"
      ],
      "js": [
        "hub.js"
      ]
    }
  ]
}
